# Personal Workspace web server
HOST=127.0.0.1
PORT=4173

# 9Router's default local API port is 20128.
# If you start 9Router on another port, update this URL.
ROUTER_BASE_URL=http://127.0.0.1:20128

# Required by 9Router for chat requests. Keep this in .env only;
# never commit your key or put it in browser-side code.
ROUTER_API_KEY=